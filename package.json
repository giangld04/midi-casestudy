{
  "name": "ama-midi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test --filter=!@ama-midi/e2e",
    "test:e2e": "pnpm --filter @ama-midi/e2e test",
    "test:load:notes": "k6 run k6/note-creation-load.js",
    "test:load:search": "k6 run k6/search-load.js",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "drizzle-orm": "0.38.4"
    }
  }
}
