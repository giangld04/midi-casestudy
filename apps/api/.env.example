# AMA-MIDI API environment variables
# Copy to apps/api/.env for local overrides (or use root .env — vitest.setup.ts loads it)
#
# Required:
DATABASE_URL=postgresql://ama_midi_user:ama_midi_pass@localhost:5432/ama_midi_db
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-32-plus-char-random-secret
AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
#
# Optional (OAuth — leave blank to disable):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
#
# Optional — AI semantic search falls back to ILIKE when absent:
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# Optional — OpenTelemetry observability (traces + metrics + logs → OTLP backend).
# Leave OTEL_EXPORTER_OTLP_ENDPOINT blank to fully disable (SDK no-ops).
# For Grafana Cloud: Home → Connections → OpenTelemetry (OTLP) gives the endpoint +
# a base64 "Authorization: Basic <instanceID:token>" header. See docs/observability.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ama-midi-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.namespace=ama-midi
LOG_LEVEL=info
