# AMA-MIDI Web environment variables (Vite build-time)
# These are injected at build time — VITE_ prefix exposes them to the browser bundle.
# Copy to apps/web/.env for local development.

# API base URL used by the web app
VITE_API_URL=http://localhost:3000
# Production: VITE_API_URL=https://your-api.railway.app
