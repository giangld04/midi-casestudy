# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
#
# ── Database ────────────────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml credentials
DATABASE_URL=postgresql://ama_midi_user:ama_midi_pass@localhost:5432/ama_midi_db
# Production (Railway): use the DATABASE_URL Railway injects automatically

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Production: Redis plugin URL injected by Railway

# ── API server ───────────────────────────────────────────────────────────────
PORT=3000

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-plus-char-random-secret
AUTH_URL=http://localhost:3000
# Production: AUTH_URL=https://your-api.railway.app

# ── CORS / Origin ────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Production: set to your deployed web URL, e.g. https://your-web.railway.app

# ── OAuth providers (optional — leave blank to disable) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Optional — semantic search falls back to ILIKE when absent
GEMINI_API_KEY=

# ── Web (Vite build-time) ────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
# Production: VITE_API_URL=https://your-api.railway.app
